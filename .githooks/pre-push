#!/bin/sh
# ─────────────────────────────────────────────────────────────────────
# Release guard: pushes of a tag are refused unless the tag and the one
# published package agree.
# The full recipe is in docs/RELEASE.md (maintainer notes, not the README).
#
# Both places (equal, and greater than what npm already has):
#   1. the git tag itself (v-prefixed or bare semver: v0.2.0 / 0.2.0)
#   2. version in packages/ext/package.json   (npm package piher)
#
# How to release:
#   1. set the version in packages/ext/package.json to the target version
#   2. git commit
#   3. git tag <target> && git push && git push --tags
#
# Install the hook once per clone (npm install also does it through prepare):
#   git config core.hooksPath .githooks
# ─────────────────────────────────────────────────────────────────────
set -u

fail() { echo "✗ [publish-guard] $1" >&2; echo '  hint: set the version in packages/ext/package.json to the tag, then re-tag.' >&2; exit 1; }

ver_of() { # $1=ref $2=json path inside that ref → prints its version
  git show "$1:$2" 2>/dev/null | node -p 'JSON.parse(require("fs").readFileSync(0,"utf8")).version' 2>/dev/null
}

while read -r local_ref local_sha _remote_ref _remote_sha; do
  case "$local_ref" in refs/tags/*) ;; *) continue ;; esac

  # a tag deletion (all-zero sha) is not checked
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac

  tag="${local_ref#refs/tags/}"
  # only tags that trigger publish.yml (v* or a leading digit); marker tags pass
  case "$tag" in v*|[0-9]*) ;; *) continue ;; esac
  ver="${tag#v}"

  ext="$(ver_of "$tag" packages/ext/package.json)" || true

  [ -n "$ext" ]  || fail "cannot read the version in packages/ext/package.json at tag $tag"

  if [ "$ver" != "$ext" ]; then
    fail "version mismatch: tag=$ver, piher=$ext"
  fi

  echo "✓ [publish-guard] ${tag}: tag = piher@${ext}"
done

exit 0
