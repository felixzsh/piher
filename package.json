{
  "name": "piher-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Workspace root for piher, the pi package that runs subagents and background jobs on herdr-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixzsh/piher.git"
  },
  "homepage": "https://github.com/felixzsh/piher#readme",
  "bugs": {
    "url": "https://github.com/felixzsh/piher/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/ext/tsconfig.json",
    "test": "npm run typecheck && timeout 240 node --test --test-timeout=120000 \"packages/*/test/**/*.test.ts\"",
    "test:mutation": "stryker run",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@stryker-mutator/core": "^10.0.0",
    "typescript": "~5.9.3"
  }
}
