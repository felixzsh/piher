node_modules/
# macOS Finder artifacts (a global ignore usually covers this; tracked so CI and fresh clones stay clean)
.DS_Store
# The CI workflows must be tracked (a global gitignore often ignores .github/, so this is an explicit exception)
!.github/
!.github/**
docs/research/
reports/
# Release notes the publish workflow writes before handing them to the Release
.github/release-notes.md
# tsc --incremental state (a local build artifact, never committed)
.tsbuildinfo
packages/ext/.tsbuildinfo
.stryker-tmp/
# /piher-config doc output (machine-truth report; regenerate on demand)
.piher/config-report.md
# Delegation state: one task record per task plus the session view, per repository, never
# committed (never the parent .piher/, whose roles/ are meant to be committed)
.piher/tasks/
# Legacy delegation ledger (deleted; kept ignored so old checkouts stay clean)
.piher/history/

# Development-only docs (reviews, RFCs, per-feature design notes) are local artifacts:
# the repository tracks user-facing documentation and code only. Remove a line here if a
# document becomes user-facing.
code review.md
docs/rfc-*.md
docs/piher-config-command.md
docs/adr/
docs/history/
docs/efficiency-review-*.md
docs/herdr-0.9.1-optimization-design.md
spike/
